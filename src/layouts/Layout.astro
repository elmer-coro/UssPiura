---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Universidad Señor de Sipán | USS",
  description = "Formamos el futuro con educación, investigación e innovación.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#333333" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>
