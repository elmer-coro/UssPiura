---
const milestones = [
  {
    year: "1985",
    title: "Nuestros inicios",
    description:
      "Espacio para presentar los antecedentes y el origen de la Universidad Señor de Sipán.",
  },
  {
    year: "Crecimiento",
    title: "Expansión institucional",
    description:
      "Espacio para destacar el crecimiento y desarrollo de la universidad.",
  },
  {
    year: "Piura",
    title: "Presencia en nuestra región",
    description:
      "Aquí incorporaremos la historia de la llegada y desarrollo de la Filial Piura.",
  },
];
---

<section id="historia" class="bg-white py-16">
  <div class="container-uss">
    <span class="mb-3 block h-1 w-10 bg-uss-green"></span>

    <p class="text-xs font-bold uppercase tracking-[2px] text-green-700">
      Nuestra trayectoria
    </p>

    <h2 class="mt-2 text-3xl font-black text-uss-text sm:text-4xl">
      Nuestra historia
    </h2>

    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-slate-500">
      Conoce el camino de nuestra institución y su compromiso con la educación
      superior.
    </p>

    <div class="relative mt-12 grid gap-8 md:grid-cols-3">
      <div
        class="absolute left-0 right-0 top-3 hidden h-0.5 bg-slate-200 md:block"
      >
      </div>

      {
        milestones.map((item) => (
          <article class="relative">
            <div class="relative z-10 mb-5 flex h-7 w-7 items-center justify-center rounded-full border-4 border-white bg-uss-green shadow-md">
              <span class="h-2 w-2 rounded-full bg-white" />
            </div>

            <span class="text-sm font-black tracking-widest text-green-600">
              {item.year}
            </span>

            <h3 class="mt-2 text-xl font-bold text-uss-text">{item.title}</h3>

            <p class="mt-3 text-sm leading-relaxed text-slate-500">
              {item.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
