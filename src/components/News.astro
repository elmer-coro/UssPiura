---
const news = [
  {
    category: "NOTICIAS",
    title: "USS inaugura moderno laboratorio de investigación",
    description:
      "Un espacio para impulsar la innovación y el desarrollo de soluciones para el país.",
    date: "15 de abril de 2025",
    image:
      "https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=700&q=80",
    alt: "Edificio de instalaciones universitarias",
  },
  {
    category: "ACADÉMICO",
    title: "Estudiantes USS destacan en concurso nacional de innovación",
    description:
      "Proyecto de emprendimiento fue reconocido entre los mejores del país.",
    date: "10 de abril de 2025",
    image:
      "https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?auto=format&fit=crop&w=700&q=80",
    alt: "Estudiantes en una biblioteca universitaria",
  },
  {
    category: "VIDA UNIVERSITARIA",
    title: "Gran acogida en la Semana de la Cultura USS",
    description:
      "Actividades artísticas, deportivas y académicas reunieron a toda la comunidad.",
    date: "7 de abril de 2025",
    image:
      "https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=700&q=80",
    alt: "Auditorio durante un evento",
  },
  {
    category: "INVESTIGACIÓN",
    title: "USS fortalece sus alianzas internacionales",
    description:
      "Nuevas oportunidades de intercambio y colaboración en proyectos de investigación.",
    date: "2 de abril de 2025",
    image:
      "https://images.unsplash.com/photo-1523580494863-6f3031224c94?auto=format&fit=crop&w=700&q=80",
    alt: "Grupo de estudiantes en una actividad universitaria",
  },
];
---

<section id="noticias" class="section-padding bg-white">
  <div class="container-uss">
    <div class="mb-5 flex items-end justify-between gap-4">
      <div>
        <span class="mb-3 block h-[2px] w-9 bg-uss-green"></span>
        <h2
          class="text-2xl font-extrabold tracking-tight text-uss-text md:text-[29px]"
        >
          La USS en movimiento
        </h2>
      </div>

      <a
        href="#noticias"
        class="flex items-center gap-3 text-[10px] font-semibold"
      >
        Ver todas las noticias
        <span class="text-lg text-uss-green">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        news.map((item) => (
          <article class="group overflow-hidden rounded-md border border-gray-200 bg-white transition hover:shadow-md">
            <a href="#noticias" class="block overflow-hidden">
              <img
                src={item.image}
                alt={item.alt}
                loading="lazy"
                class="h-[112px] w-full object-cover transition duration-500 group-hover:scale-105"
              />
            </a>

            <div class="p-3">
              <span class="inline-block bg-uss-green px-2 py-1 text-[8px] font-bold tracking-wide">
                {item.category}
              </span>

              <h3 class="mt-2 text-[12px] font-bold leading-[1.4] text-uss-text">
                <a href="#noticias" class="hover:underline">
                  {item.title}
                </a>
              </h3>

              <p class="mt-2 text-[10px] leading-[1.5] text-uss-muted">
                {item.description}
              </p>

              <time class="mt-3 block text-[9px] text-uss-muted">
                {item.date}
              </time>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
