---
const programs = [
  {
    title: "Facultad de Ciencias Empresariales",
    description:
      "Forma tu futuro en el mundo de los negocios, la administración y la gestión empresarial.",
    image:
      "./public/facultad-ciencias-empresariales.webp",
    alt: "Estudiantes universitarios en el campus",
    href: "carreras",
  },
  {
    title: "Facultad de Ciencias de la Salud",
    description:
      "Prepárate para transformar vidas mediante la ciencia, la salud y el cuidado humano.",
    image:
      "./public/facultad-ciencias-salud.webp",
    alt: "Profesionales colaborando en equipo",
    href: "carreras",
  },
  {
    title: "Facultad de Ingeniería y Urbanismo",
    description:
      "Diseña, crea e innova soluciones para construir el futuro de nuestra sociedad.",
    image:
      "./public/facultad-ingenieria-urbanismo.webp",
    alt: "Grupo de estudiantes trabajando juntos",
    href: "carreras",
  },
  {
    title: "Facultad de Derecho y Humanidades",
    description:
      "Desarrolla tu vocación profesional con justicia, valores y compromiso social.",
    image:
      "./public/facultad-derecho-humanidades.webp",
    alt: "Estudiante trabajando con una computadora portátil",
    href: "carreras",
  },
];
---

<section id="carreras" class="section-padding bg-uss-light">
  <div class="container-uss">
    <div class="mb-5 flex items-end justify-between gap-4">
      <div>
        <span class="mb-3 block h-0.5 w-9 bg-uss-green"></span>
        <h2
          class="text-2xl font-extrabold tracking-tight text-uss-text md:text-[29px]"
        >
          Encuentra tu próximo paso
        </h2>
      </div>

      <a
        href="#admision"
        class="hidden items-center gap-3 text-[10px] font-semibold sm:flex"
      >
        Ver todas las carreras
        <span class="text-lg text-uss-green">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        programs.map((program) => (
          <a
            href={program.href}
            class="group overflow-hidden rounded-md border border-gray-200 bg-white p-1.5 transition duration-300 hover:-translate-y-1 hover:shadow-lg"
          >
            <div class="overflow-hidden rounded-sm">
              <img
                src={program.image}
                alt={program.alt}
                loading="lazy"
                class="h-36.25 w-full object-cover transition duration-500 group-hover:scale-105"
              />
            </div>

            <div class="px-2.5 pb-3 pt-3">
              <h3 class="text-sm font-bold text-uss-text">{program.title}</h3>

              <p class="mt-2 min-h-8.5 text-[11px] leading-normal text-uss-muted">
                {program.description}
              </p>

              <span class="mt-2 inline-block text-2xl leading-none text-uss-green transition group-hover:translate-x-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-narrow-right"
                >
                  <>
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M5 12l14 0" />
                    <path d="M15 16l4 -4" />
                    <path d="M15 8l4 4" />
                  </>
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <a
      href="#admision"
      class="mt-5 inline-flex items-center gap-2 text-xs font-semibold sm:hidden"
    >
      Ver todas las carreras <span class="text-lg text-uss-green">→</span>
    </a>
  </div>
</section>
