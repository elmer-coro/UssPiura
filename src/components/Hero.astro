<section
  id="universidad"
  class="relative isolate grid min-h-108 grid-cols-[45%_55%] overflow-hidden max-[640px]:flex max-[640px]:flex-col"
>
  <!-- Cuadrícula superior -->
  <div
    class="hero-grid absolute right-0 top-0 z-3 hidden h-36 w-17.5 sm:block"
    aria-hidden="true"
  >
  </div>

  <!-- Contenido principal -->
  <div
    class="relative z-20 col-start-1 row-start-1 flex items-center py-12 pl-[max(24px,calc((100vw-1378px)/2))] max-[900px]:pl-6 max-[900px]:pr-0 max-[640px]:px-5 max-[640px]:py-10"
  >
    <div class="w-full max-w-117.5">
      <span
        class="inline-flex rounded-md bg-uss-green px-3.5 py-1.5 text-[10px] font-extrabold uppercase tracking-[0.2em]"
      >
        Formamos el futuro
      </span>

      <h1
        class="mt-5 text-5xl font-black leading-[0.98] tracking-[-0.055em] text-uss-text md:text-6xl max-[900px]:text-[clamp(38px,5.5vw,52px)] max-[640px]:text-[clamp(43px,12vw,58px)]"
      >
        Tu talento transforma el mundo<span class="text-uss-green">.</span>
      </h1>

      <p
        class="mt-5 max-w-97.5 text-sm leading-[1.65] text-uss-muted md:text-base"
      >
        Descubre una formación conectada con la innovación, la investigación y
        las oportunidades reales.
      </p>

      <!-- Botones -->
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="carreras"
          class="inline-flex items-center gap-4 rounded-lg bg-uss-dark px-5 py-3 text-[11px] font-bold text-white transition hover:bg-black"
        >
          Explora nuestras carreras
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m15 8 4 4-4 4"></path>
          </svg>
        </a>

        <a
          href="conoce-la-uss"
          class="inline-flex items-center gap-3 rounded-lg border border-uss-dark px-5 py-3 text-[11px] font-semibold transition hover:bg-uss-light"
        >
          Conoce la USS
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m15 8 4 4-4 4"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Fotografía -->
  <div
    class="hero-photo relative z-1 col-start-2 row-start-1 overflow-hidden max-[640px]:h-75"
  >
    <img
      src="/photo-hero.jpg"
      alt="Estudiantes universitarios en el campus de la Universidad Señor de Sipán"
      class="block h-full min-h-108 w-full object-cover object-center max-[640px]:min-h-75"
    />
  </div>

  <!-- Elemento geométrico verde -->
  <div
    class="hero-green-shape pointer-events-none absolute right-[-115px] top-0 z-[2] h-full w-[240px] bg-uss-green max-[640px]:bottom-0 max-[640px]:right-[-45px] max-[640px]:top-auto max-[640px]:h-[190px] max-[640px]:w-[100px]"
    aria-hidden="true"
  >
  </div>

  <!-- Estadística -->
  <div
    class="absolute bottom-13.5 right-[max(42px,calc((100vw-1330px)/2))] z-15 min-w-36 rounded-xl border border-[#8c8c8c] border-l-4 border-l-uss-green bg-[#222222] px-4 py-2.5 text-white max-[900px]:bottom-5.5 max-[900px]:right-5 max-[640px]:bottom-4.5"
  >
    <strong class="text-[29px] leading-[1.1] text-uss-green">
      25<span class="text-[19px]">+</span>
    </strong>

    <p class="mt-0.75 text-xs leading-[1.4]">
      años formando<br />líderes
    </p>
  </div>

  <!-- Cuadrícula inferior -->
  <div
    class="hero-grid hero-grid-bottom absolute bottom-0 right-0 z-3 h-12.5 w-17.5"
    aria-hidden="true"
  >
  </div>
</section>

<style>
  /* Imagen diagonal */
  .hero-photo {
    clip-path: polygon(20% 0, 100% 0, 100% 100%, 0 100%);
  }

  /* Forma geométrica verde */
  .hero-green-shape {
    clip-path: polygon(100% 0, 100% 100%, 0 100%, 52% 24%);
  }

  /* Patrón de cuadrícula */
  .hero-grid {
    background-image:
      linear-gradient(#33333320 1px, transparent 1px),
      linear-gradient(90deg, #33333320 1px, transparent 1px);

    background-size: 15px 15px;
  }

  /* 
   RESPONSIVE*/

  @media (max-width: 640px) {
    .hero-photo {
      clip-path: none;
    }
  }
</style>
